classDiagram
    direction TB

    class Utilisateur {
        +Integer id
        +String nom
        +String email
        +String mot_de_passe
        +DateTime derniere_connexion
        +DateTime created_at
        +DateTime updated_at
    }

    class Role {
        +Integer id
        +String nom
        +String guard_name
        +DateTime created_at
        +DateTime updated_at
    }

    class Permission {
        +Integer id
        +String nom
        +String guard_name
        +DateTime created_at
        +DateTime updated_at
    }

    class Formateur {
        +String matricule
        +DateTime created_at
        +DateTime updated_at
    }

    class Etudiant {
        +String code_etudiant
        +Integer classe_id
        +DateTime created_at
        +DateTime updated_at
    }

    class Classe {
        +Integer id
        +String nom
        +String promotion
        +DateTime created_at
        +DateTime updated_at
    }

    class UniteApprentissage {
        +Integer id
        +String nom
        +String code
        +DateTime created_at
        +DateTime updated_at
    }

    class Session {
        +Integer id
        +Integer unite_apprentissage_id
        +String nom
        +DateTime date
        +DateTime created_at
        +DateTime updated_at
    }

    class Objectif {
        +Integer id
        +Integer session_id
        +String nom
        +String description
        +DateTime created_at
        +DateTime updated_at
    }

    class QCM {
        +Integer id
        +Integer objectif_id
        +Integer formateur_id
        +String titre
        +Integer duree_minutes
        +Integer score_reussite
        +Boolean est_publie
        +DateTime created_at
        +DateTime updated_at
    }

    class Question {
        +Integer id
        +Integer qcm_id
        +String texte
        +String type
        +Integer points
        +String explication_feedback
        +DateTime created_at
        +DateTime updated_at
    }

    class Option {
        +Integer id
        +Integer question_id
        +String texte
        +Boolean est_correcte
        +String feedback_specifique
        +DateTime created_at
        +DateTime updated_at
    }

    class Tentative {
        +Integer id
        +Integer etudiant_id
        +Integer qcm_id
        +Integer score_obtenu
        +DateTime date_debut
        +DateTime date_fin
        +String statut
        +DateTime created_at
        +DateTime updated_at
    }

    class Reponse {
        +Integer id
        +Integer tentative_id
        +Integer question_id
        +DateTime repondu_a
        +DateTime created_at
        +DateTime updated_at
    }

    class ChoixReponse {
        +Integer id
        +Integer reponse_id
        +Integer option_id
        +DateTime created_at
        +DateTime updated_at
    }

    %% ───────── RBAC ─────────
    Utilisateur "1" -- "0..*" Role : possède
    Role "*" -- "*" Permission : accorde

    %% ───────── Héritage ─────────
    Utilisateur <|-- Formateur
    Utilisateur <|-- Etudiant

    %% ───────── Structure des Classes ─────────
    Classe "1" -- "0..*" Etudiant : appartient_a

    %% ───────── Structure Pédagogique ─────────
    UniteApprentissage "1" -- "0..*" Session : contient
    Session "1" -- "0..*" Objectif : possède
    Objectif "1" -- "1" QCM : évalue

    %% ───────── Structure du QCM ─────────
    QCM "1" -- "1..*" Question : contient
    Question "1" -- "2..*" Option : propose

    %% ───────── Création ─────────
    Formateur "1" -- "0..*" QCM : crée

    %% ───────── Participation ─────────
    Etudiant "1" -- "0..*" Tentative : effectue
    QCM "1" -- "0..*" Tentative : reçoit

    %% ───────── Réponses ─────────
    Tentative "1" -- "1..*" Reponse : inclut
    Question "1" -- "0..*" Reponse : répondue_dans

    %% ───────── Sélections Choix Multiples ─────────
    Reponse "1" -- "0..*" ChoixReponse : contient
    Option "1" -- "0..*" ChoixReponse : sélectionnée_dans
