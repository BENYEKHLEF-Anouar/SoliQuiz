@startuml
skinparam actorStyle awesome
left to right direction
skinparam packageStyle rectangle

skinparam usecase {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    ArrowColor #2E86C1
}

' ==============================
' ACTORS
' ==============================
actor "Administrateur" as A
actor "Formateur" as F
actor "SoliLMS" as LMS

' ==============================
' SYSTEM
' ==============================
package "Système SoliQuiz - Intégration (Sprint 4)" {

    package "Espace Administrateur" {
        usecase "Configuration API SoliLMS" as UC_CONF
    }

    package "Espace Formateur" {
        usecase "Exporter les notes vers SoliLMS" as UC_EXPORT
    }
}

' ==============================
' ACTOR ASSOCIATIONS
' ==============================

A -- UC_CONF
F -- UC_EXPORT

LMS -- UC_CONF
LMS -- UC_EXPORT

@enduml
