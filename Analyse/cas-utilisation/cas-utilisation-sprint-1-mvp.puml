@startuml

skinparam actorStyle awesome
left to right direction
skinparam packageStyle rectangle

skinparam usecase {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    ArrowColor #2E86C1
}

' ==============================
' ACTORS
' ==============================
actor "Utilisateur" as U
actor "Administrateur" as A
actor "Formateur" as F
actor "Étudiant" as E
actor "Application Mobile" as M

A --|> U
F --|> U
E --|> U


' ==============================
' SYSTEM
' ==============================
package "Système SoliQuiz - MVP (Sprint 1)" {

    package "Sécurité & Accès" {
        usecase "S'authentifier\n(Login/Rôle)" as UC_AUTH
        usecase "Gérer les comptes utilisateurs" as UC_USERS
    }

    package "Module Web (Gestion & Passation)" {
        usecase "Concevoir un QCM\n(Structure & Questions)" as UC_CREATE
        usecase "Ajouter Questions\net Choix de réponses" as UC_ANSWERS

        usecase "Répondre au QCM" as UC_PLAY
        usecase "Générer le score final" as UC_CALC

        UC_CREATE ..> UC_ANSWERS : <<include>>
        UC_PLAY ..> UC_CALC : <<include>>
    }

    package "Module Mobile - APK (Consultation)" {
        usecase "Consulter son score\naprès évaluation" as UC_MOB_E
        usecase "Consulter ses QCM\net les scores de la classe" as UC_MOB_F
    }

    package "Interface Mobile / API Integration" {
        usecase "Consommer les données (API)" as UC_API
    }

}

' ==============================
' ACTOR ASSOCIATIONS
' ==============================

U -- UC_AUTH

A -- UC_USERS

F -- UC_CREATE
F -- UC_MOB_F

E -- UC_PLAY
E -- UC_MOB_E

M -- UC_API


' ==============================
' MOBILE / API LOGIC
' ==============================

UC_API ..> UC_MOB_E : <<include>>
UC_API ..> UC_MOB_F : <<include>>


' ==============================
' SCORE DEPENDENCIES
' ==============================

UC_MOB_E ..> UC_CALC : <<extend>>
UC_MOB_F ..> UC_CALC : <<extend>>

@enduml