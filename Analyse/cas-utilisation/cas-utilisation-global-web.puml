@startuml
skinparam actorStyle awesome
left to right direction
skinparam packageStyle rectangle

skinparam usecase {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    ArrowColor #2E86C1
}

' ==============================
' ACTORS HIERARCHY
' ==============================
actor "Utilisateur" as U
actor "Administrateur" as A
actor "Formateur" as F
actor "Étudiant" as E
actor "Application Mobile" as M
' actor "SoliLMS" as LMS

' Inheritance
U <|-- A
U <|-- F
U <|-- E

' ==============================
' SYSTEM
' ==============================
package "SoliQuiz Web" {

    package "Accès & Sécurité" {
        usecase "Accéder à la Landing Page" as UC_LANDING
        usecase "Interagir avec le Chatbot" as UC_CHAT
        usecase "S'authentifier" as UC_LOGIN

        U -- UC_LANDING
        U -- UC_CHAT
        U -- UC_LOGIN
    }

    package "Espace Administrateur" {
        usecase "Voir le tableau de bord global" as UC10
        usecase "Gérer les utilisateurs (Rôles)" as UC9
        usecase "Gérer la pédagogie" as UC_PEDA
        usecase "Gérer les classes & cohortes" as UC_CLASS
        usecase "Superviser tous les QCMs" as UC_QCMS

        A -- UC10
        A -- UC9
        A -- UC_PEDA
        A -- UC_CLASS
        A -- UC_QCMS
    }

    package "Espace Formateur" {
        usecase "Gérer les QCM (CRUD)" as UC1
        usecase "Gérer les Questions et Choix" as UC2
        usecase "Lier QCM à une Session/Objectif" as UC3
        usecase "Consulter les résultats" as UC5

        F -- UC1
        F -- UC3
        F -- UC5

        UC3 ..> UC1 : <<extend>>
        UC1 ..> UC2 : <<include>>
    }

    package "Espace Étudiant" {
        usecase "Réaliser une évaluation (Passer QCM)" as UC4
        usecase "Calculer automatiquement les scores" as UC6
        usecase "Consulter l'historique des évaluations" as UC7
        usecase "Accéder au feedback détaillé/correction" as UC8

        E -- UC4
        E -- UC7

        UC4 ..> UC6 : <<include>>
        UC7 <.. UC8 : <<extend>>
    }

    package "Interface Mobile / API" {
        usecase "Consommer/Accéder à l'API" as UC_API
        
        M -- UC_API
    }
}
@enduml